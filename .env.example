# Copie ce fichier en .env pour les commandes locales (auth, cookies, tests).
# Sur GitHub, ces valeurs sont des « secrets » du dépôt.

GROQ_API_KEY=
CEREBRAS_API_KEY=          # facultatif (carte bancaire requise chez Cerebras)
STATE_KEY=                 # python -m clipbot keygen

# YouTube (étape d'installation 3)
YOUTUBE_CLIENT_SECRETS=secrets/youtube_client_secret.json
YOUTUBE_TOKEN_JSON=

# TikTok (étape d'installation 5)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
TIKTOK_TOKEN_JSON=

# Instagram (étape d'installation 4)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# Cookies YouTube (python -m clipbot cookies pack cookies.txt)
YT_COOKIES_B64=

# Utilisé par `python -m clipbot go` (tourne sur ton PC)
CLIPBOT_REPO=Fahd-Chaib/ClipBot
